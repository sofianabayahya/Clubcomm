-- VOORSTEL (Besluit 144): correctie van de 8 DCG-weekplannen. NIET UITVOEREN ZONDER AKKOORD.
-- Gemaakt op 2026-10-30 met de leesgegevens van productie en docs/methodiek/persoonlijk/periodisering-o13-import-CONCEPT.csv.
-- Per weekplan: de dagwaarden van de eerste trainingsdag (hoofdthema, leerniveau, leerroute) eruit; bij een eigen training (alleen do 29-10)
-- ter informatie bij die dag (dagen); de wedstrijdsituatie (hoofdthema van de wedstrijdregel) bij de wedstrijd, observatiepunten ongewijzigd.
-- Veilig, alles of niets: elke regel werkt alleen als het weekplan nog precies is zoals gecontroleerd (het hele weekplan wordt vergeleken met de gecontroleerde versie).
-- Is één weekplan intussen veranderd, dan stopt het script met een melding en wordt er NIETS aangepast (ook de andere weekplannen niet).
-- Na afloop: de melding 'klaar: 8 weekplannen'. Trainingen, concepten en observatiepunten worden niet aangeraakt.
do $correctie$
declare n int;
begin
  -- wk-O12-1-2026-10-26 (week wk 44): dagwaarden van 2026-10-29 uit het weekplan; bewaard bij die dag (eigen training, periodisering niet toegepast); wedstrijdsituatie: Opbouwen achteruit: eerste druklijn uitspelen
  update public.rij set data = jsonb_set(jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{dagen}', coalesce(data->'dagen', '{}'::jsonb) || $j${"2026-10-29":{"hoofdthema":"Technische onderbouw opbouwen","niveaus":["ln-uitvoeren","ln-herkennen"],"route":"Gerichte vorm; eerste contact en passkwaliteit; laag tempo als nodig"}}$j$::jsonb), '{wedstrijd,context}', to_jsonb($t$Opbouwen achteruit: eerste druklijn uitspelen$t$::text)), '{stempel}', to_jsonb('sukmdn81djhuos'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-10-26' and data->>'stempel' = 'srkyojm14vun3s' and data->'methodiek'->>'hoofdthema' = $t$Technische onderbouw opbouwen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261031' and data->'wedstrijd'->'context' is null
    and data = $v${"id":"wk-O12-1-2026-10-26","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-10-26","teamId":"O12-1","stempel":"srkyojm14vun3s","eigenaar":"p-beheer","methodiek":{"hg1":"ll-aannemen","hg2":"ll-passen","fase":"Fase 1 – concept","week":"wk 44","keten":null,"route":"Gerichte vorm; eerste contact en passkwaliteit; laag tempo als nodig","contra":"vp-6","gedrag":"Voor ontvangst kijken en eerste contact naar vrije ruimte; met passende pass de vrije speler helpen","contra2":null,"niveaus":["ln-uitvoeren","ln-herkennen"],"probleem":"vp-2","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"Technische onderbouw opbouwen","informatie":"Drukrichting; vrije ruimte voor de eerste lijn; medespeler achter druk","ketenTekst":"Waarnemen → voorbereiden → helpen","observatie":"","contraTekst":"Vooruitgang van tegenstander voorkomen: jagen en as sluiten","teamfunctie":"tf-aanvallen","ondersteunend":["ll-vrijkomen"],"probleemTekst":"Vooruitgang creëren","teamfunctieTekst":"","ondersteunendTekst":"Vrijkomen – Timen"},"wedstrijd":{"bron":"periodisering-o13-import-CONCEPT","actId":"w-o12-20261031","punten":[{"id":"obmvthr400yti","tekst":"Komt de bal gecontroleerd voorbij de eerste druklijn?","uitkomst":null},{"id":"obmvthr400kqv","tekst":"Herkennen spelers de relevante informatie voordat zij handelen?","uitkomst":null},{"id":"obmvthr400e17","tekst":"Wat gebeurt er direct na balwinst of balverlies?","uitkomst":null}]}}$v$::jsonb;
  get diagnostics n = row_count;
  if n <> 1 then raise exception 'Gestopt: % is veranderd sinds de controle; er is niets aangepast', 'wk-O12-1-2026-10-26'; end if;
  -- wk-O12-1-2026-11-02 (week wk 45): dagwaarden van 2026-11-03 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Vrije speler herkennen in de opbouw
  update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Vrije speler herkennen in de opbouw$t$::text)), '{stempel}', to_jsonb('s1cnq2qi1e8r0um'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-02' and data->>'stempel' = 's40pq4s1xjbn43' and data->'methodiek'->>'hoofdthema' = $t$Passingkwaliteit en timing van vrijlopen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261107' and data->'wedstrijd'->'context' is null
    and data = $v${"id":"wk-O12-1-2026-11-02","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-11-02","teamId":"O12-1","stempel":"s40pq4s1xjbn43","eigenaar":"p-beheer","methodiek":{"hg1":"ll-passen","hg2":"ll-vrijkomen","fase":"Fase 1 – concept","week":"wk 45","keten":"hk-vrij-aannemen-passen","route":"A1/B1 als techniek; A2/B2 met passende druk en spacing of interleaving","contra":"vp-6","gedrag":"Pass met passende snelheid; medespeler komt op het juiste moment uit de dekkingsschaduw","contra2":null,"niveaus":["ln-uitvoeren","ln-herkennen"],"probleem":"vp-2","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"Passingkwaliteit en timing van vrijlopen","informatie":"Dekkingsschaduw; druk op bal; ruimte achter eerste druklijn","ketenTekst":"Timen → voorbereiden → helpen","observatie":"","contraTekst":"Vooruitgang voorkomen: passlijn door as sluiten","teamfunctie":"tf-aanvallen","ondersteunend":["ll-aannemen"],"probleemTekst":"Vooruitgang creëren","teamfunctieTekst":"","ondersteunendTekst":"Aannemen en meenemen – Voorbereiden"},"wedstrijd":{"bron":"periodisering-o13-import-CONCEPT","actId":"w-o12-20261107","punten":[{"id":"obmvthr400cjm","tekst":"Herkennen spelers de vrije speler achter de druk?","uitkomst":null},{"id":"obmvthr400vc0","tekst":"Herkennen spelers de relevante informatie voordat zij handelen?","uitkomst":null},{"id":"obmvthr400brv","tekst":"Wat gebeurt er direct na balwinst of balverlies?","uitkomst":null}]}}$v$::jsonb;
  get diagnostics n = row_count;
  if n <> 1 then raise exception 'Gestopt: % is veranderd sinds de controle; er is niets aangepast', 'wk-O12-1-2026-11-02'; end if;
  -- wk-O12-1-2026-11-09 (week wk 46): dagwaarden van 2026-11-10 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Van opbouwen naar middenveld: voordeel benutten
  update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Van opbouwen naar middenveld: voordeel benutten$t$::text)), '{stempel}', to_jsonb('s899xbolq0t5y'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-09' and data->>'stempel' = 's1v9lxmk1m18xgb' and data->'methodiek'->>'hoofdthema' = $t$Vrijkomen en gerichte pass onder tempo$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261114' and data->'wedstrijd'->'context' is null
    and data = $v${"id":"wk-O12-1-2026-11-09","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-11-09","teamId":"O12-1","stempel":"s1v9lxmk1m18xgb","eigenaar":"p-beheer","methodiek":{"hg1":"ll-vrijkomen","hg2":"ll-passen","fase":"Fase 1 – concept","week":"wk 46","keten":null,"route":"Veel herhalingen met varianten naar niveau","contra":"vp-6","gedrag":"Op juiste moment positie wisselen en de vrije speler voorbij druk aanspelen","contra2":null,"niveaus":["ln-uitvoeren","ln-herkennen"],"probleem":"vp-3","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"Vrijkomen en gerichte pass onder tempo","informatie":"Vrije speler; overtal; positie van 6/8/back; herstel tegenstander","ketenTekst":"Herkennen → timen → helpen → opnieuw vrijlopen","observatie":"","contraTekst":"Vooruitgang voorkomen: druk en rugdekking","teamfunctie":"tf-aanvallen","ondersteunend":["ll-1v1-aanvallend"],"probleemTekst":"Voordeel uitspelen","teamfunctieTekst":"","ondersteunendTekst":"1v1 aanvallend – Manipuleren"},"wedstrijd":{"bron":"periodisering-o13-import-CONCEPT","actId":"w-o12-20261114","punten":[{"id":"obmvthr400zlx","tekst":"Wordt een ontstaan overtal benut voordat de tegenstander herstelt?","uitkomst":null},{"id":"obmvthr400f15","tekst":"Herkennen spelers de relevante informatie voordat zij handelen?","uitkomst":null},{"id":"obmvthr400mqt","tekst":"Wat gebeurt er direct na balwinst of balverlies?","uitkomst":null}]}}$v$::jsonb;
  get diagnostics n = row_count;
  if n <> 1 then raise exception 'Gestopt: % is veranderd sinds de controle; er is niets aangepast', 'wk-O12-1-2026-11-09'; end if;
  -- wk-O12-1-2026-11-16 (week wk 47): dagwaarden van 2026-11-17 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Van voordeel naar scoringskans
  update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Van voordeel naar scoringskans$t$::text)), '{stempel}', to_jsonb('s2mvv6c1buv26f'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-16' and data->>'stempel' = 's8jr3a81mnjthv' and data->'methodiek'->>'hoofdthema' = $t$1v1 richting doel en tijdig vrijlopen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261121' and data->'wedstrijd'->'context' is null
    and data = $v${"id":"wk-O12-1-2026-11-16","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-11-16","teamId":"O12-1","stempel":"s8jr3a81mnjthv","eigenaar":"p-beheer","methodiek":{"hg1":"ll-1v1-aanvallend","hg2":"ll-vrijkomen","fase":"Fase 1 – concept","week":"wk 47","keten":null,"route":"Individueel 1v1 en simpele afwerkvervolgactie","contra":"vp-6","gedrag":"Herken ruimte voor passeren of combineren; loop zonder bal naar kansrijke positie","contra2":null,"niveaus":["ln-uitvoeren","ln-kiezen"],"probleem":"vp-4","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"1v1 richting doel en tijdig vrijlopen","informatie":"Verdediger uit balans; doelruimte; medespeler vrij; keeper","ketenTekst":"Manipuleren → timen/helpen → benutten","observatie":"","contraTekst":"Vooruitgang voorkomen: verdedigen richting eigen doel","teamfunctie":"tf-aanvallen","ondersteunend":["ll-6","ll-passen"],"probleemTekst":"Een scoringskans creëren","teamfunctieTekst":"","ondersteunendTekst":"Afwerken – Benutten; Passen – Helpen"},"wedstrijd":{"bron":"periodisering-o13-import-CONCEPT","actId":"w-o12-20261121","punten":[{"id":"obmvthr4005j6","tekst":"Leidt voordeel tot een bewuste doelpoging uit kansrijke positie?","uitkomst":null},{"id":"obmvthr400j1s","tekst":"Herkennen spelers de relevante informatie voordat zij handelen?","uitkomst":null},{"id":"obmvthr400kqk","tekst":"Wat gebeurt er direct na balwinst of balverlies?","uitkomst":null}]}}$v$::jsonb;
  get diagnostics n = row_count;
  if n <> 1 then raise exception 'Gestopt: % is veranderd sinds de controle; er is niets aangepast', 'wk-O12-1-2026-11-16'; end if;
  -- wk-O12-1-2026-11-23 (week wk 48): dagwaarden van 2026-11-24 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Samen jagen: druk op bal en as beschermen
  update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Samen jagen: druk op bal en as beschermen$t$::text)), '{stempel}', to_jsonb('s1ojs54c1wf5l4w'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-23' and data->>'stempel' = 's1kzo8wa5deit' and data->'methodiek'->>'hoofdthema' = $t$1v1 verdedigen: gecontroleerd benaderen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261128' and data->'wedstrijd'->'context' is null
    and data = $v${"id":"wk-O12-1-2026-11-23","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-11-23","teamId":"O12-1","stempel":"s1kzo8wa5deit","eigenaar":"p-beheer","methodiek":{"hg1":"ll-1v1-verdedigen","hg2":"ll-vrijkomen","fase":"Fase 1 – concept","week":"wk 48","keten":null,"route":"Houding en afstand met passende weerstand","contra":"vp-2","gedrag":"Balbezitter gecontroleerd benaderen; medespelers sluiten as en geven rugdekking","contra2":null,"niveaus":["ln-uitvoeren","ln-herkennen"],"probleem":"vp-6","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"1v1 verdedigen: gecontroleerd benaderen","informatie":"Balcontrole tegenstander; drukmoment; doel-as; onderlinge afstand","ketenTekst":"Benaderen → controleren → samen afsluiten → ingrijpen","observatie":"","contraTekst":"Vooruitgang creëren: onder druk uitspelen","teamfunctie":"tf-verdedigen","ondersteunend":["ll-passen"],"probleemTekst":"Vooruitgang van de tegenstander voorkomen","teamfunctieTekst":"","ondersteunendTekst":"Passen – Helpen (aanvallende contra-partij)"},"wedstrijd":{"bron":"periodisering-o13-import-CONCEPT","actId":"w-o12-20261128","punten":[{"id":"obmvthr400v3p","tekst":"Wordt er samen druk gezet zonder de as open te laten?","uitkomst":null},{"id":"obmvthr400kbe","tekst":"Herkennen spelers de relevante informatie voordat zij handelen?","uitkomst":null},{"id":"obmvthr400o03","tekst":"Wat gebeurt er direct na balwinst of balverlies?","uitkomst":null}]}}$v$::jsonb;
  get diagnostics n = row_count;
  if n <> 1 then raise exception 'Gestopt: % is veranderd sinds de controle; er is niets aangepast', 'wk-O12-1-2026-11-23'; end if;
  -- wk-O12-1-2026-11-30 (week wk 49): dagwaarden van 2026-12-01 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Bal veroveren en eerste actie na winst
  update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Bal veroveren en eerste actie na winst$t$::text)), '{stempel}', to_jsonb('s116mg2hxqdhae'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-30' and data->>'stempel' = 's2rkdbowmj0r' and data->'methodiek'->>'hoofdthema' = $t$Controle naar balverovering$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261205' and data->'wedstrijd'->'context' is null
    and data = $v${"id":"wk-O12-1-2026-11-30","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-11-30","teamId":"O12-1","stempel":"s2rkdbowmj0r","eigenaar":"p-beheer","methodiek":{"hg1":"ll-1v1-verdedigen","hg2":"ll-aannemen","fase":"Fase 1 – concept","week":"wk 49","keten":null,"route":"Herken slechte aanname; 1v1 met drukmoment","contra":"vp-1","gedrag":"Herken moment om in te grijpen en bereid na balwinst eerste vervolgactie voor","contra2":null,"niveaus":["ln-uitvoeren","ln-herkennen"],"probleem":"vp-7","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"Controle naar balverovering","informatie":"Slechte aanname; bal van voet; vrije ruimte en medespeler na winst","ketenTekst":"Controleren → veroveren → voorbereiden → helpen","observatie":"","contraTekst":"Bal behouden onder druk","teamfunctie":"tf-verdedigen","ondersteunend":["ll-passen"],"probleemTekst":"De bal veroveren","teamfunctieTekst":"","ondersteunendTekst":"Passen – Helpen"},"wedstrijd":{"bron":"periodisering-o13-import-CONCEPT","actId":"w-o12-20261205","punten":[{"id":"obmvthr400su2","tekst":"Veroveren spelers controle over de bal en kiezen ze daarna passend?","uitkomst":null},{"id":"obmvthr400vve","tekst":"Herkennen spelers de relevante informatie voordat zij handelen?","uitkomst":null},{"id":"obmvthr400fr2","tekst":"Wat gebeurt er direct na balwinst of balverlies?","uitkomst":null}]}}$v$::jsonb;
  get diagnostics n = row_count;
