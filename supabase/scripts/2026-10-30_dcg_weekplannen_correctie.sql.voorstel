-- VOORSTEL (Besluit 144): correctie van de 8 DCG-weekplannen. NIET UITVOEREN ZONDER AKKOORD.
-- Gemaakt op 2026-10-30 met de leesgegevens van productie en docs/methodiek/persoonlijk/periodisering-o13-import-CONCEPT.csv.
-- Per weekplan: de dagwaarden van de eerste trainingsdag (hoofdthema, leerniveau, leerroute) eruit; bij een eigen training (alleen do 29-10)
-- ter informatie bij die dag (dagen); de wedstrijdsituatie (hoofdthema van de wedstrijdregel) bij de wedstrijd, observatiepunten ongewijzigd.
-- Veilig: elke regel werkt alleen als het weekplan nog precies is zoals gecontroleerd (de controlecode stempel); anders verandert er niets.
-- Na afloop: 8 regels terug. Trainingen, concepten en observatiepunten worden niet aangeraakt.
begin;
-- wk-O12-1-2026-10-26 (week wk 44): dagwaarden van 2026-10-29 uit het weekplan; bewaard bij die dag (eigen training, periodisering niet toegepast); wedstrijdsituatie: Opbouwen achteruit: eerste druklijn uitspelen
update public.rij set data = jsonb_set(jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{dagen}', coalesce(data->'dagen', '{}'::jsonb) || $j${"2026-10-29":{"hoofdthema":"Technische onderbouw opbouwen","niveaus":["ln-uitvoeren","ln-herkennen"],"route":"Gerichte vorm; eerste contact en passkwaliteit; laag tempo als nodig"}}$j$::jsonb), '{wedstrijd,context}', to_jsonb($t$Opbouwen achteruit: eerste druklijn uitspelen$t$::text)), '{stempel}', to_jsonb('sukmdn81djhuos'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-10-26' and data->>'stempel' = 'srkyojm14vun3s' and data->'methodiek'->>'hoofdthema' = $t$Technische onderbouw opbouwen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261031' and data->'wedstrijd'->'context' is null
  returning id;
-- wk-O12-1-2026-11-02 (week wk 45): dagwaarden van 2026-11-03 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Vrije speler herkennen in de opbouw
update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Vrije speler herkennen in de opbouw$t$::text)), '{stempel}', to_jsonb('s1cnq2qi1e8r0um'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-02' and data->>'stempel' = 's40pq4s1xjbn43' and data->'methodiek'->>'hoofdthema' = $t$Passingkwaliteit en timing van vrijlopen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261107' and data->'wedstrijd'->'context' is null
  returning id;
-- wk-O12-1-2026-11-09 (week wk 46): dagwaarden van 2026-11-10 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Van opbouwen naar middenveld: voordeel benutten
update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Van opbouwen naar middenveld: voordeel benutten$t$::text)), '{stempel}', to_jsonb('s899xbolq0t5y'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-09' and data->>'stempel' = 's1v9lxmk1m18xgb' and data->'methodiek'->>'hoofdthema' = $t$Vrijkomen en gerichte pass onder tempo$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261114' and data->'wedstrijd'->'context' is null
  returning id;
-- wk-O12-1-2026-11-16 (week wk 47): dagwaarden van 2026-11-17 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Van voordeel naar scoringskans
update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Van voordeel naar scoringskans$t$::text)), '{stempel}', to_jsonb('s2mvv6c1buv26f'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-16' and data->>'stempel' = 's8jr3a81mnjthv' and data->'methodiek'->>'hoofdthema' = $t$1v1 richting doel en tijdig vrijlopen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261121' and data->'wedstrijd'->'context' is null
  returning id;
-- wk-O12-1-2026-11-23 (week wk 48): dagwaarden van 2026-11-24 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Samen jagen: druk op bal en as beschermen
update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Samen jagen: druk op bal en as beschermen$t$::text)), '{stempel}', to_jsonb('s1ojs54c1wf5l4w'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-23' and data->>'stempel' = 's1kzo8wa5deit' and data->'methodiek'->>'hoofdthema' = $t$1v1 verdedigen: gecontroleerd benaderen$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261128' and data->'wedstrijd'->'context' is null
  returning id;
-- wk-O12-1-2026-11-30 (week wk 49): dagwaarden van 2026-12-01 uit het weekplan (de concepttraining van die dag heeft ze al zelf); wedstrijdsituatie: Bal veroveren en eerste actie na winst
update public.rij set data = jsonb_set(jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{wedstrijd,context}', to_jsonb($t$Bal veroveren en eerste actie na winst$t$::text)), '{stempel}', to_jsonb('s116mg2hxqdhae'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-11-30' and data->>'stempel' = 's2rkdbowmj0r' and data->'methodiek'->>'hoofdthema' = $t$Controle naar balverovering$t$ and data->'wedstrijd'->>'actId' = 'w-o12-20261205' and data->'wedstrijd'->'context' is null
  returning id;
-- wk-O12-1-2026-12-07 (week wk 50): dagwaarden van 2026-12-08 uit het weekplan (de concepttraining van die dag heeft ze al zelf)
update public.rij set data = jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{stempel}', to_jsonb('sgstta8bg3t14'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-12-07' and data->>'stempel' = 's1g1ws7xo5zflf' and data->'methodiek'->>'hoofdthema' = $t$Eerste contact en bal afschermen$t$
  returning id;
-- wk-O12-1-2026-12-14 (week wk 51): dagwaarden van 2026-12-15 uit het weekplan (de concepttraining van die dag heeft ze al zelf)
update public.rij set data = jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{stempel}', to_jsonb('s1n615ij35n652'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-12-14' and data->>'stempel' = 'sqv0trs13duqlr' and data->'methodiek'->>'hoofdthema' = $t$Afwerken: moment en uitvoering$t$
  returning id;
commit;
