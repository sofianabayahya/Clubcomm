  -- wk-O12-1-2026-12-07 (week wk 50): dagwaarden van 2026-12-08 uit het weekplan (de concepttraining van die dag heeft ze al zelf)
  update public.rij set data = jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{stempel}', to_jsonb('sgstta8bg3t14'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-12-07' and data->>'stempel' = 's1g1ws7xo5zflf' and data->'methodiek'->>'hoofdthema' = $t$Eerste contact en bal afschermen$t$
    and data = $v${"id":"wk-O12-1-2026-12-07","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-12-07","teamId":"O12-1","stempel":"s1g1ws7xo5zflf","eigenaar":"p-beheer","methodiek":{"hg1":"ll-aannemen","hg2":"ll-1v1-aanvallend","fase":"Fase 1 – concept","week":"wk 50","keten":null,"route":"Verschil technische beheersing; niveauvariaties","contra":"vp-6","gedrag":"Herken druk; houd bal onder controle via eerste contact, beschermen, wegdraaien of hulp","contra2":null,"niveaus":["ln-uitvoeren","ln-herkennen"],"probleem":"vp-1","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"Eerste contact en bal afschermen","informatie":"Drukrichting; beschikbare ruimte; steun; nieuwe vooruitmogelijkheid","ketenTekst":"Waarnemen → voorbereiden/manipuleren → helpen","observatie":"","contraTekst":"Vooruitgang voorkomen: gezamenlijk drukzetten","teamfunctie":"tf-aanvallen","ondersteunend":["ll-passen","ll-vrijkomen"],"probleemTekst":"Bal behouden onder druk","teamfunctieTekst":"","ondersteunendTekst":"Passen – Helpen; Vrijkomen – Timen"},"wedstrijd":null}$v$::jsonb;
  get diagnostics n = row_count;
  if n <> 1 then raise exception 'Gestopt: % is veranderd sinds de controle; er is niets aangepast', 'wk-O12-1-2026-12-07'; end if;
  -- wk-O12-1-2026-12-14 (week wk 51): dagwaarden van 2026-12-15 uit het weekplan (de concepttraining van die dag heeft ze al zelf)
  update public.rij set data = jsonb_set((data #- '{methodiek,hoofdthema}' #- '{methodiek,niveaus}' #- '{methodiek,route}'), '{stempel}', to_jsonb('s1n615ij35n652'::text))
  where club_id = 'dcg' and soort = 'trainingsplannen' and id = 'wk-O12-1-2026-12-14' and data->>'stempel' = 'sqv0trs13duqlr' and data->'methodiek'->>'hoofdthema' = $t$Afwerken: moment en uitvoering$t$
    and data = $v${"id":"wk-O12-1-2026-12-14","bron":"periodisering-o13-import-CONCEPT","week":true,"datum":"2026-12-14","teamId":"O12-1","stempel":"sqv0trs13duqlr","eigenaar":"p-beheer","methodiek":{"hg1":"ll-6","hg2":"ll-passen","fase":"Fase 1 – concept","week":"wk 51","keten":null,"route":"Gericht afwerken met keuze in schotrichting","contra":null,"gedrag":"Herken scoringsmoment en kies schot of betere medespeler; speel doelgericht samen","contra2":null,"niveaus":["ln-uitvoeren","ln-herkennen"],"probleem":"vp-5","transfer":"Partijvorm: toets of het gedrag zelfstandig terugkomt; invulling door trainer","onderbouw":"","hoofdthema":"Afwerken: moment en uitvoering","informatie":"Positie keeper; druk; scoringshoek; vrije medespeler","ketenTekst":"Timen → helpen → benutten","observatie":"","contraTekst":"Vooruitgang tegenstander voorkomen en bal veroveren","teamfunctie":"tf-aanvallen","ondersteunend":["ll-vrijkomen","ll-1v1-aanvallend"],"probleemTekst":"Een scoringskans benutten","teamfunctieTekst":"","ondersteunendTekst":"Vrijkomen – Timen; 1v1 aanvallend – Manipuleren"},"wedstrijd":null}$v$::jsonb;
