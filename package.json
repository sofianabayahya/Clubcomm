{
  "name": "clubcomm",
  "version": "0.2.0",
  "private": true,
  "description": "ClubComm — communicatie en organisatie voor jeugdvoetbal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/automaat.test.mjs tests/verwijzingen.test.mjs && playwright test",
    "test:snel": "node --test tests/verwijzingen.test.mjs && playwright test --grep",
    "test:server": "node --test tests/automaat.test.mjs",
    "test:veilig": "bash supabase/tests/rechtentest-lokaal.sh",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
